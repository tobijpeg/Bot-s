# Required: values for your Supabase project.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY

# Generate once with: openssl rand -base64 32
BOT_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Public website origin (scheme + hostname only; do not add /Bot-s/).
PUBLIC_APP_ORIGIN=https://tobijpeg.github.io

# Optional production host settings
APP_PORT=4174

# Optional: uncomment this to enable the Ollama AI service below.
# OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b

# One or more comma-separated platform admin emails. ADMIN_EMAIL remains supported for older deployments.
ADMIN_EMAILS=admin@example.com,second-admin@example.com
ADMIN_EMAIL=
